# SERVER-ONLY. Copy to supabase/functions/.env (gitignored), then:
#   supabase secrets set --env-file supabase/functions/.env
ENVIRONMENT=production                 # "production" forbids the mock AI provider

# AI (Anthropic Claude)
AI_PROVIDER=anthropic                  # anthropic | mock (local dev/tests only)
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-5-5               # optional override
AI_RATE_LIMIT_PER_MINUTE=8

# RevenueCat
REVENUECAT_SECRET_API_KEY=sk_...       # RevenueCat *secret* API key (v1 REST)
REVENUECAT_WEBHOOK_SECRET=long-random-string   # also set as the webhook Authorization header in RevenueCat

# Optional: voice-note transcription
TRANSCRIPTION_PROVIDER=                # "openai" to enable
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional: restrict CORS for browser callers (comma separated). Native apps don't send Origin.
ALLOWED_ORIGINS=*
