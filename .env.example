# ─────────────────────────────────────────────────────────────────────────────
# TapKit configuration reference. NEVER commit real values.
# Each app has its own env file; this file documents all of them in one place.
# ─────────────────────────────────────────────────────────────────────────────

# ── CLIENT-SAFE (embedded in the iOS app / web bundle) ──────────────────────
# apps/mobile/.env
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key        # protected by RLS
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxx          # RevenueCat *public* Apple SDK key
EXPO_PUBLIC_WEB_URL=https://tapkit.app                            # where public portfolios are served
EXPO_PUBLIC_SUPPORT_EMAIL=support@tapkit.app
# Build-time only (EAS / app.config.ts)
IOS_BUNDLE_IDENTIFIER=app.tapkit.ios
EAS_PROJECT_ID=

# apps/web/.env.local
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=https://tapkit.app
NEXT_PUBLIC_APP_STORE_URL=                                        # set once the app is live
NEXT_PUBLIC_SUPPORT_EMAIL=support@tapkit.app

# ── SERVER-ONLY SECRETS (Supabase Edge Function secrets) ────────────────────
# Set with: supabase secrets set --env-file supabase/functions/.env
# See supabase/functions/.env.example. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# are injected automatically by Supabase — never put the service role key in an app.
